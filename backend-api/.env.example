PORT=10000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=
HASURA_GRAPHQL_URL=https://your-project-subdomain.graphql.eu-central-1.nhost.run/v1/graphql
HASURA_ADMIN_SECRET=your-hasura-admin-secret
# Leave JWT settings blank in local public-only dev mode.
NHOST_SUBDOMAIN=
NHOST_REGION=
# Optional explicit override. If unset, the API derives the JWKS URL from NHOST_SUBDOMAIN + NHOST_REGION.
NHOST_JWKS_URL=
# Optional hardening if you want to pin claims verification tighter when JWT verification is enabled.
NHOST_JWT_ISSUER=
NHOST_JWT_AUDIENCE=
# Optional override for asymmetric verification without JWKS.
NHOST_JWT_PUBLIC_KEY=
TEAM_EVENT_BONUS_POINTS=5
