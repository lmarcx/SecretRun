{
  "name": "@secret-run/backend-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "pnpm run build && node --env-file-if-exists=.env dist/server.js",
    "test": "pnpm run build && node --test --test-concurrency=1 --test-isolation=none dist/modules/auth/dev-auth-mode.test.js dist/modules/events/routes.test.js dist/modules/events/service.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck"
  },
  "dependencies": {
    "fastify": "^5.3.3",
    "graphql-request": "^7.1.2",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
