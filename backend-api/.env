PORT=10000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=
HASURA_GRAPHQL_URL=http://127.0.0.1:8080/v1/graphql
HASURA_ADMIN_SECRET=hasura-admin-secret
NHOST_SUBDOMAIN=your-project-subdomain
NHOST_REGION=eu-central-1
# Optional explicit override. If unset, the API derives the JWKS URL from NHOST_SUBDOMAIN + NHOST_REGION.
NHOST_JWKS_URL=https://your-project-subdomain.auth.eu-central-1.nhost.run/v1/.well-known/jwks.json
# Optional hardening if you want to pin claims verification tighter.
NHOST_JWT_ISSUER=
NHOST_JWT_AUDIENCE=
# Optional override for asymmetric verification without JWKS.
NHOST_JWT_PUBLIC_KEY=
TEAM_EVENT_BONUS_POINTS=5
