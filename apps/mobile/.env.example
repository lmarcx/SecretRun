# Real Nhost Cloud project configuration for mobile.
EXPO_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
EXPO_PUBLIC_NHOST_REGION=eu-central-1
EXPO_PUBLIC_HASURA_GRAPHQL_URL=https://your-project-subdomain.graphql.eu-central-1.nhost.run/v1/graphql
# Optional override. Leave unset to use the derived Nhost Cloud functions host.
EXPO_PUBLIC_TRACKPOINTS_ENDPOINT=https://your-project-subdomain.functions.eu-central-1.nhost.run/v1/trackpoints
