# Production / portfolio web build (Vercel).
#
# Expo loads this file with higher priority than .env when exporting in
# production mode, so it overrides the local-dev values committed in .env.
#
# Auth is intentionally left empty: with no Nhost subdomain/region the app runs
# in "auth unavailable" mode and never forces a login screen, so the public
# events / leaderboard / teams screens are browsable by anyone.
EXPO_PUBLIC_NHOST_SUBDOMAIN=
EXPO_PUBLIC_NHOST_REGION=

# Point GraphQL at the bundled serverless mock (api/graphql.js on the same
# Vercel domain). Relative URL resolves against the deployment origin.
EXPO_PUBLIC_HASURA_GRAPHQL_URL=/api/graphql

# Leave the standalone backend API unset so events use the public GraphQL
# fallback (served by the same mock) instead of a real Fastify instance.
EXPO_PUBLIC_BACKEND_API_URL=
EXPO_PUBLIC_TRACKPOINTS_ENDPOINT=
