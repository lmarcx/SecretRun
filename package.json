{
  "name": "secret-run",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "concurrently -n BACKEND,MOBILE \"pnpm --filter @secret-run/backend backend:start\" \"pnpm --filter @secret-run/mobile dev\"",
    "dev:full": "concurrently -n BACKEND,API,MOBILE \"pnpm --filter @secret-run/backend backend:start\" \"pnpm --filter @secret-run/backend-api dev\" \"pnpm --filter @secret-run/mobile dev\"",
    "dev:mobile": "pnpm --filter @secret-run/mobile dev",
    "dev:backend": "pnpm --filter @secret-run/backend backend:start",
    "dev:api": "pnpm --filter @secret-run/backend-api dev",
    "backend:stop": "pnpm --filter @secret-run/backend backend:stop",
    "backend:logs": "pnpm --filter @secret-run/backend backend:logs",
    "db:migrate": "pnpm --filter @secret-run/backend db:migrate",
    "db:seed": "pnpm --filter @secret-run/backend db:seed",
    "db:seed:full": "pnpm --filter @secret-run/backend db:seed:full",
    "db:seed:clear": "pnpm --filter @secret-run/backend db:seed:clear",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
